#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <4>;
        };
    };

    behaviors {
        layer_switch: layer_switch {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_SWITCH";
            bindings = <&to>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tap_kp_hold_to: tap_kp_hold_to {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_KP_HOLD_TO";
            bindings = <&to>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    macros {
        double_zero: double_zero {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "DOUBLE_ZERO";
        };

        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESCAPE  &kp Q         &kp W     &kp E  &kp R  &kp T           &kp Y             &kp U      &kp I      &kp O                 &kp P      &kp BSPC
&lt 3 TAB   &kp A         &kp S     &kp D  &kp F  &kp G           &kp H             &kp J      &kp K      &kp L                 &kp MINUS  &kp ENTER
&kp LSHFT   &kp Z         &kp X     &kp C  &kp V  &kp B           &kp LEFT_BRACKET  &kp SPACE  &kp N      &kp M                 &kp COMMA  &kp DOT    &kp LS(NUMBER_1)  &kp LS(SLASH)
&kp LCTRL   &kp LEFT_WIN  &kp LALT  &kp B  &mo 4  &kp LANGUAGE_2  &kp SPACE         &kp LANG1  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp APOS   &mo 1
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans           &mo 2
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &kp LS(TAB)      &kp UP_ARROW  &kp TAB  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(LS(TAB))  &kp LC(LG(LEFT_ARROW))  &kp LG(TAB)  &kp LG(LC(RIGHT_ARROW))  &kp LC(TAB)          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LA(LEFT)     &mkp MB1                &mkp MB3     &mkp MB2                 &kp LA(RIGHT_ARROW)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans           &trans                  &trans       &kp LG(LEFT)             &kp LG(UP_ARROW)     &kp LG(RIGHT)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans           &kp LC(F4)              &trans       &trans                   &trans               &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &kp HOME        &kp UP_ARROW    &kp END    &kp PSCRN  &trans  &trans  &kp SLASH      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &kp DEL    &trans  &trans  &kp BACKSPACE  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS
&trans  &trans          &trans          &trans     &trans     &trans  &trans  &trans         &trans        &kp ASTRK     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&trans  &trans          &trans          &trans     &trans     &trans  &trans  &trans         &lt 1 N0      &double_zero  &kp DOT       &kp ENTER
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F7   &kp F8   &kp F9   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F4   &kp F5   &kp F6   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &kp F1   &kp F2  &kp F3  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F10  &kp F11  &kp F12  &trans
            >;
        };
    };
};
